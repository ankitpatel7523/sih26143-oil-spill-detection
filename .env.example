# ==============================================================================
# SIH26143: Oil Spill Detection & Vessel Attribution System (NTRO)
# Environment Configuration Template
# Copy this file to '.env' or '.env.local' and set your variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React Vite / Vercel)
# ------------------------------------------------------------------------------
# Base URL for the Python FastAPI backend API.
# Local Development: http://127.0.0.1:8000
# Production / Vercel: Set to your hosted backend URL (e.g. https://your-backend.onrender.com)
VITE_API_URL=http://127.0.0.1:8000

# Optional: Google Gemini Vision API Key for secondary multimodal look-alike cross-verification.
# (If left empty, the built-in local CFAR, Lee Speckle, and Otsu models handle 100% of detection)
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Python FastAPI)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,https://*.vercel.app
